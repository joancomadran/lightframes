---
import { getCollection, render } from 'astro:content'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import ToolList from '../components/ToolList.astro'
import { SITE, absoluteUrl } from '../config'
import { entryAlternates, entryPath, pagePath, type Post } from '../content'
import { formatDate, href, langOf, ui } from '../i18n'
import Base from '../layouts/Base.astro'
import { blogPosting, breadcrumbs } from '../schema'

interface Props {
  post: Post
}

const { post } = Astro.props
const { data } = post
const lang = langOf(post.id)
const t = ui[lang]
const path = entryPath(post)
const headline = data.h1 ?? data.title
const { Content } = await render(post)
const tools = (await getCollection('tools', (tool) => langOf(tool.id) === lang && data.tools.includes(tool.data.key)))
const crumbs = [
  { name: t.home, path: href('home', lang) },
  { name: t.blog, path: href('blog', lang) },
  { name: headline, path },
]
const aboutPath = await pagePath('about', lang)
---

<Base
  lang={lang}
  title={data.title}
  description={data.description}
  path={path}
  alternates={await entryAlternates(post)}
  ogImage={data.ogImage}
  ogType="article"
  noindex={data.noindex || data.draft}
  schema={[
    blogPosting({
      url: absoluteUrl(path),
      headline,
      description: data.description,
      lang,
      published: data.published,
      updated: data.updated,
      image: data.ogImage ?? SITE.ogImage,
      keywords: data.keywords,
    }),
    breadcrumbs(crumbs),
  ]}
>
  <article class="wrap page page--narrow">
    <Breadcrumbs lang={lang} items={crumbs} />
    <header class="page-head">
      <h1>{headline}</h1>
      <p class="meta">
        {t.post.by} <a href={aboutPath} rel="author">{data.author}</a>
        {', '}
        <time datetime={data.published.toISOString()}>{formatDate(data.published, lang)}</time>
        {
          data.updated && (
            <>
              {'. '}
              {t.post.updated}{' '}
              <time datetime={data.updated.toISOString()}>{formatDate(data.updated, lang)}</time>
            </>
          )
        }
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
    {
      tools.length > 0 && (
        <aside class="section-block" aria-labelledby="try-title">
          <h2 id="try-title">{t.post.tryIt}</h2>
          <ToolList tools={tools} />
        </aside>
      )
    }
  </article>
</Base>
