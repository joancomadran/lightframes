---
import Breadcrumbs from '../components/Breadcrumbs.astro'
import EditorCta from '../components/EditorCta.astro'
import FaqList from '../components/FaqList.astro'
import { absoluteUrl } from '../config'
import { getFaq } from '../content'
import { href, sectionAlternates, ui, type Lang } from '../i18n'
import Base from '../layouts/Base.astro'
import { breadcrumbs, faqPage, webPage } from '../schema'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = ui[lang]
const copy = t.faqPage
const path = href('faq', lang)
const url = absoluteUrl(path)
const items = await getFaq(lang)
const crumbs = [
  { name: t.home, path: href('home', lang) },
  { name: copy.h1, path },
]
---

<Base
  lang={lang}
  title={copy.title}
  description={copy.description}
  path={path}
  alternates={sectionAlternates('faq')}
  schema={[
    webPage({ url, name: copy.h1, description: copy.description, lang }),
    breadcrumbs(crumbs),
    faqPage(url, items),
  ]}
>
  <div class="wrap page page--narrow">
    <Breadcrumbs lang={lang} items={crumbs} />
    <header class="page-head">
      <h1>{copy.h1}</h1>
    </header>
    <FaqList items={items} openFirst />
    <div class="section-block">
      <EditorCta lang={lang} />
    </div>
  </div>
</Base>
