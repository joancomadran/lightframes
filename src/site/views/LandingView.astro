---
import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'
import FaqList from '../components/FaqList.astro'
import ToolList from '../components/ToolList.astro'
import { SITE, absoluteUrl } from '../config'
import { entryPath, getFaq, getPosts, getTools } from '../content'
import { EDITOR_PATH, formatDate, href, sectionAlternates, ui, type Lang } from '../i18n'
import { LOOKS, landing } from '../landing'
import Base from '../layouts/Base.astro'
import { faqPage, webApplication, webPage } from '../schema'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = ui[lang]
const c = landing[lang]
const path = href('home', lang)
const url = absoluteUrl(path)
const tools = await getTools(lang)
const faq = (await getFaq(lang)).slice(0, 6)
const posts = (await getPosts(lang)).slice(0, 3)
const [first] = LOOKS

// Hero before/after photos: AVIF/WebP/JPEG at a few widths so phones don't download the 1600 px original
const lookFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/looks/*.jpg', { eager: true })
const WIDTHS = [480, 800, 1200, 1600]
const SIZES = '(min-width: 1000px) min(56vw, 680px), calc(100vw - 40px)'
async function lookImage(id: string) {
  const file = lookFiles[`../../assets/looks/${id}.jpg`]
  if (!file) throw new Error(`Missing hero image src/assets/looks/${id}.jpg`)
  const [avif, webp, jpeg] = await Promise.all(
    // AVIF at 60 looks like JPEG/WebP at 80 and is still the smallest
    (['avif', 'webp', 'jpeg'] as const).map((format) =>
      getImage({ src: file.default, widths: WIDTHS, format, quality: format === 'avif' ? 60 : 80 }),
    ),
  )
  return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, jpeg: jpeg.src, jpegSet: jpeg.srcSet.attribute }
}
const original = await lookImage('original')
const looks = await Promise.all(LOOKS.map(async (look) => ({ ...look, img: await lookImage(look.id) })))
const firstImg = looks[0].img
---

<Base
  lang={lang}
  title={c.title}
  fullTitle={c.title}
  description={c.description}
  path={path}
  alternates={sectionAlternates('home')}
  schema={[
    webPage({ url, name: c.h1, description: c.description, lang }),
    webApplication(lang, tools.map((tool) => tool.data.label)),
    ...(faq.length ? [faqPage(url, faq)] : []),
  ]}
>
  <script is:inline slot="head">
    // The installed app used to start at "/": send it to the editor instead of the landing page
    if (matchMedia('(display-mode: standalone)').matches) location.replace('/editor')
  </script>

  <section class="hero wrap">
    <div class="hero__text">
      <h1>{c.h1}</h1>
      <p class="lead">{c.lead}</p>
      <div class="hero__actions">
        <a class="button button--primary button--large" href={EDITOR_PATH}>{t.openEditor}</a>
        <a class="button button--ghost button--large" href="#how">{c.secondary}</a>
      </div>
      <ul class="facts">
        {c.facts.map((fact) => <li>{fact}</li>)}
      </ul>
    </div>

    <figure class="compare" data-compare style="--split: 50%">
      <div class="compare__frame">
        <picture>
          <source type="image/avif" srcset={original.avif} sizes={SIZES} />
          <source type="image/webp" srcset={original.webp} sizes={SIZES} />
          <img
            src={original.jpeg}
            srcset={original.jpegSet}
            sizes={SIZES}
            width="1600"
            height="1067"
            alt=""
            fetchpriority="high"
            decoding="async"
          />
        </picture>
        <picture>
          <source type="image/avif" srcset={firstImg.avif} sizes={SIZES} data-compare-avif />
          <source type="image/webp" srcset={firstImg.webp} sizes={SIZES} data-compare-webp />
          <img
            class="compare__after"
            src={firstImg.jpeg}
            srcset={firstImg.jpegSet}
            sizes={SIZES}
            width="1600"
            height="1067"
            alt=""
            decoding="async"
            data-compare-after
          />
        </picture>
        <span class="compare__tag compare__tag--before">{c.compare.before}</span>
        <span class="compare__tag compare__tag--after" data-compare-name>{first.name}</span>
        <span class="compare__handle" aria-hidden="true"></span>
        <input
          class="compare__range"
          type="range"
          min="0"
          max="100"
          value="50"
          aria-label={c.compare.slider}
          data-compare-range
        />
      </div>
      <figcaption>
        <div class="looks" role="group" aria-label={c.compare.looks}>
          {
            looks.map((look) => (
              <button
                type="button"
                data-look={look.id}
                data-name={look.name}
                data-avif={look.img.avif}
                data-webp={look.img.webp}
                data-jpeg={look.img.jpeg}
                data-jpeg-set={look.img.jpegSet}
                aria-pressed={look.id === first.id ? 'true' : 'false'}
              >
                <img src={`/site/looks/thumbs/${look.id}.jpg`} alt="" width="64" height="43" loading="lazy" decoding="async" />
                {look.name}
              </button>
            ))
          }
        </div>
        <p>{c.compare.caption}</p>
      </figcaption>
    </figure>
  </section>

  <section class="band" aria-labelledby="privacy-title">
    <div class="wrap split">
      <div>
        <h2 id="privacy-title">{c.privacy.h2}</h2>
        {c.privacy.body.map((p) => <p>{p}</p>)}
      </div>
      <ul class="points">
        {
          c.privacy.points.map((point) => (
            <li>
              <h3>{point.h3}</h3>
              <p>{point.p}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="tools-title">
    <header class="section__head">
      <h2 id="tools-title">{c.tools.h2}</h2>
      <p>{c.tools.lead}</p>
    </header>
    <ToolList tools={tools} />
    <p class="section__more"><a href={href('tools', lang)}>{c.tools.all}</a></p>
  </section>

  <section class="wrap section" id="how" aria-labelledby="how-title">
    <header class="section__head">
      <h2 id="how-title">{c.how.h2}</h2>
    </header>
    <div class="how">
      <ol class="how__steps">
        {
          c.how.steps.map((step) => (
            <li>
              <h3>{step.h3}</h3>
              <p>{step.p}</p>
            </li>
          ))
        }
      </ol>
      <img
        class="how__shot"
        src="/site/shots/editor.jpg"
        width="1600"
        height="887"
        alt={c.how.shotAlt}
        loading="lazy"
        decoding="async"
      />
    </div>
  </section>

  {
    faq.length > 0 && (
      <section class="wrap section section--narrow" aria-labelledby="faq-title">
        <header class="section__head">
          <h2 id="faq-title">{c.faq.h2}</h2>
        </header>
        <FaqList items={faq} />
        <p class="section__more">
          <a href={href('faq', lang)}>{c.faq.all}</a>
        </p>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="wrap section" aria-labelledby="blog-title">
        <header class="section__head">
          <h2 id="blog-title">{c.blog.h2}</h2>
        </header>
        <ul class="post-list post-list--grid">
          {posts.map((post) => (
            <li>
              <a href={entryPath(post)}>
                <h3>{post.data.h1 ?? post.data.title}</h3>
                <p>{post.data.description}</p>
              </a>
              <time datetime={post.data.published.toISOString()}>{formatDate(post.data.published, lang)}</time>
            </li>
          ))}
        </ul>
        <p class="section__more">
          <a href={href('blog', lang)}>{c.blog.all}</a>
        </p>
      </section>
    )
  }

  <section class="wrap end" aria-labelledby="end-title">
    <h2 id="end-title">{c.end.h2}</h2>
    <p>{c.end.p}</p>
    <div class="hero__actions">
      <a class="button button--primary button--large" href={EDITOR_PATH}>{t.openEditor}</a>
      <a class="button button--ghost button--large" href={SITE.github} rel="noopener">{c.end.github}</a>
    </div>
  </section>
</Base>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-compare]')) {
    const range = root.querySelector<HTMLInputElement>('[data-compare-range]')!
    const after = root.querySelector<HTMLImageElement>('[data-compare-after]')!
    const avif = root.querySelector<HTMLSourceElement>('[data-compare-avif]')!
    const webp = root.querySelector<HTMLSourceElement>('[data-compare-webp]')!
    const name = root.querySelector<HTMLElement>('[data-compare-name]')!
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-look]')
    range.addEventListener('input', () => root.style.setProperty('--split', `${range.value}%`))
    for (const button of buttons) {
      button.addEventListener('click', () => {
        const { avif: avifSet, webp: webpSet, jpeg, jpegSet } = button.dataset
        if (avifSet) avif.srcset = avifSet
        if (webpSet) webp.srcset = webpSet
        if (jpegSet) after.srcset = jpegSet
        if (jpeg) after.src = jpeg
        name.textContent = button.dataset.name ?? ''
        for (const other of buttons) other.setAttribute('aria-pressed', String(other === button))
      })
    }
  }
</script>
