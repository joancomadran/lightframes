---
import FaqList from '../components/FaqList.astro'
import ToolList from '../components/ToolList.astro'
import { SITE, absoluteUrl } from '../config'
import { entryPath, getFaq, getPosts, getTools } from '../content'
import { EDITOR_PATH, formatDate, href, sectionAlternates, ui, type Lang } from '../i18n'
import { landing } from '../landing'
import { xmpLandingPath } from '../xmpLanding'
import Base from '../layouts/Base.astro'
import { faqPage, videoObject, webApplication, webPage } from '../schema'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = ui[lang]
const c = landing[lang]
const path = href('home', lang)
const url = absoluteUrl(path)
const allTools = await getTools(lang)
const tools = allTools.filter((tool) => tool.data.featured)
const faq = (await getFaq(lang)).slice(0, 6)
const posts = (await getPosts(lang)).slice(0, 3)
---

<Base
  lang={lang}
  title={c.title}
  fullTitle={c.title}
  description={c.description}
  path={path}
  alternates={sectionAlternates('home')}
  schema={[
    webPage({ url, name: c.h1, description: c.description, lang }),
    webApplication(lang, allTools.map((tool) => tool.data.label)),
    videoObject({
      url,
      name: c.video.label,
      description: c.video.caption,
      lang,
      contentUrl: '/video/promo.mp4',
      thumbnailUrl: '/video/promo-poster.jpg',
      uploadDate: '2026-10-20T14:51:00+02:00',
      duration: 'PT51S',
    }),
    ...(faq.length ? [faqPage(url, faq)] : []),
  ]}
>
  <script is:inline slot="head">
    // The installed app used to start at "/": send it to the editor instead of the landing page
    if (matchMedia('(display-mode: standalone)').matches) location.replace('/editor')
  </script>

  <section class="hero wrap">
    <div class="hero__text">
      <h1>{c.h1}</h1>
      <p class="lead">{c.lead}</p>
      <div class="hero__actions">
        <a class="button button--primary button--large" href={EDITOR_PATH}>{t.openEditor}</a>
        <a class="button button--ghost button--large" href="#how">{c.secondary}</a>
      </div>
      <ul class="facts">
        {c.facts.map((fact) => <li>{fact}</li>)}
      </ul>
      <p class="hero__aside">
        <a href={xmpLandingPath[lang]}>{lang === 'es' ? 'Usar presets .xmp sin Lightroom →' : 'Use .xmp presets without Lightroom →'}</a>
      </p>
    </div>

    <figure class="promo">
      <video
        class="promo__video"
        src="/video/promo.mp4"
        poster="/video/promo-poster.jpg"
        width="1280"
        height="720"
        autoplay
        muted
        loop
        playsinline
        controls
        preload="metadata"
        aria-label={c.video.label}
        data-promo
      ></video>
      <figcaption>{c.video.caption}</figcaption>
    </figure>
  </section>

  <section class="band" aria-labelledby="privacy-title">
    <div class="wrap split">
      <div>
        <h2 id="privacy-title">{c.privacy.h2}</h2>
        {c.privacy.body.map((p) => <p>{p}</p>)}
      </div>
      <ul class="points">
        {
          c.privacy.points.map((point) => (
            <li>
              <h3>{point.h3}</h3>
              <p>{point.p}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="tools-title">
    <header class="section__head">
      <h2 id="tools-title">{c.tools.h2}</h2>
      <p>{c.tools.lead}</p>
    </header>
    <ToolList tools={tools} />
    <p class="section__more"><a href={href('tools', lang)}>{c.tools.all}</a></p>
  </section>

  <section class="wrap section" id="how" aria-labelledby="how-title">
    <header class="section__head">
      <h2 id="how-title">{c.how.h2}</h2>
    </header>
    <div class="how">
      <ol class="how__steps">
        {
          c.how.steps.map((step) => (
            <li>
              <h3>{step.h3}</h3>
              <p>{step.p}</p>
            </li>
          ))
        }
      </ol>
      <img
        class="how__shot"
        src="/site/shots/editor.jpg"
        width="1600"
        height="887"
        alt={c.how.shotAlt}
        loading="lazy"
        decoding="async"
      />
    </div>
  </section>

  {
    faq.length > 0 && (
      <section class="wrap section section--narrow" aria-labelledby="faq-title">
        <header class="section__head">
          <h2 id="faq-title">{c.faq.h2}</h2>
        </header>
        <FaqList items={faq} />
        <p class="section__more">
          <a href={href('faq', lang)}>{c.faq.all}</a>
        </p>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="wrap section" aria-labelledby="blog-title">
        <header class="section__head">
          <h2 id="blog-title">{c.blog.h2}</h2>
        </header>
        <ul class="post-list post-list--grid">
          {posts.map((post) => (
            <li>
              <a href={entryPath(post)}>
                <h3>{post.data.h1 ?? post.data.title}</h3>
                <p>{post.data.description}</p>
              </a>
              <time datetime={post.data.published.toISOString()}>{formatDate(post.data.published, lang)}</time>
            </li>
          ))}
        </ul>
        <p class="section__more">
          <a href={href('blog', lang)}>{c.blog.all}</a>
        </p>
      </section>
    )
  }

  <section class="wrap end" aria-labelledby="end-title">
    <h2 id="end-title">{c.end.h2}</h2>
    <p>{c.end.p}</p>
    <div class="hero__actions">
      <a class="button button--primary button--large" href={EDITOR_PATH}>{t.openEditor}</a>
      <a class="button button--ghost button--large" href={SITE.github} rel="noopener">{c.end.github}</a>
    </div>
  </section>
</Base>

<script>
  // Autoplay is decoration: leave the video on its poster for people who asked for less motion
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const video of document.querySelectorAll<HTMLVideoElement>('[data-promo]')) {
      video.autoplay = false
      video.pause()
    }
  }
</script>
