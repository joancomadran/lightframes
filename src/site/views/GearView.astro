---
import { AMAZON_DISCLOSURE, GEAR, amazonUrl } from '../../lib/affiliate'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import { absoluteUrl } from '../config'
import { href, sectionAlternates, ui, type Lang } from '../i18n'
import Base from '../layouts/Base.astro'
import { breadcrumbs, webPage } from '../schema'

interface Props {
  lang: Lang
}

/** Spanish labels for the shared GEAR list (src/lib/affiliate.ts is English, used by the editor). */
const ES: Record<string, string> = {
  'Storage & backup': 'Almacenamiento y copias',
  Editing: 'Edición',
  Shooting: 'Fotografía',
  'Fast SD cards': 'Tarjetas SD rápidas',
  'V30 / UHS-II for RAW bursts': 'V30 / UHS-II para ráfagas en RAW',
  'Portable SSD': 'SSD portátil',
  'Back up a shoot on the go': 'Copia la sesión donde estés',
  'USB-C card reader': 'Lector de tarjetas USB-C',
  'Import straight to laptop or phone': 'Importa directo al portátil o al móvil',
  'Monitor calibrator': 'Calibrador de monitor',
  'Colours that match the print': 'Colores que coinciden con la copia impresa',
  'Photo printer': 'Impresora fotográfica',
  'Print your favourite edits': 'Imprime tus ediciones favoritas',
  '50mm f/1.8 prime': 'Objetivo 50 mm f/1.8',
  'The classic first lens': 'El primer objetivo clásico',
  'Travel tripod': 'Trípode de viaje',
  'Long exposures & night shots': 'Largas exposiciones y fotos nocturnas',
  'Sensor cleaning kit': 'Kit de limpieza del sensor',
  'Fewer spots to retouch': 'Menos manchas que retocar',
}

const { lang } = Astro.props
const t = ui[lang]
const copy = t.gearPage
const tr = (text: string) => (lang === 'es' ? (ES[text] ?? text) : text)
const path = href('gear', lang)
const crumbs = [
  { name: t.home, path: href('home', lang) },
  { name: copy.h1, path },
]
---

<Base
  lang={lang}
  title={copy.title}
  description={copy.description}
  path={path}
  alternates={sectionAlternates('gear')}
  schema={[webPage({ url: absoluteUrl(path), name: copy.h1, description: copy.description, lang }), breadcrumbs(crumbs)]}
>
  <div class="wrap page">
    <Breadcrumbs lang={lang} items={crumbs} />
    <header class="page-head">
      <h1>{copy.h1}</h1>
      <p class="lead">{copy.lead}</p>
      <p class="disclosure">{AMAZON_DISCLOSURE}</p>
    </header>
    {
      GEAR.map((group) => (
        <section class="section-block">
          <h2>{tr(group.title)}</h2>
          <ul class="gear-list">
            {group.items.map((item) => (
              <li>
                <h3>{tr(item.title)}</h3>
                <p>{tr(item.detail)}</p>
                <a href={amazonUrl(item)} rel="sponsored nofollow noopener" target="_blank">
                  {copy.cta}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
