---
// Self-hosted variable fonts (same files Google Fonts serves, with font-display: swap); no third-party request
import '@fontsource-variable/bricolage-grotesque/opsz.css'
import '@fontsource-variable/figtree'
import Analytics from '@vercel/analytics/astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import StarLink from '../components/StarLink.astro'
import { SITE, absoluteUrl } from '../config'
import { DEFAULT_LANG, LOCALES, ui, type Lang } from '../i18n'
import { author, organization, website } from '../schema'
import '../styles/site.css'

interface Props {
  lang: Lang
  /** Page title without the brand; ignored when `fullTitle` is set. */
  title: string
  fullTitle?: string
  description: string
  /** Canonical path of this page, e.g. /tools/raw-photo-editor */
  path: string
  /** This page in each language, for hreflang. */
  alternates?: Partial<Record<Lang, string>>
  ogImage?: string
  ogType?: 'website' | 'article'
  noindex?: boolean
  /** JSON-LD nodes; Organization, WebSite and the author Person are always added. */
  schema?: Record<string, unknown>[]
}

const {
  lang,
  title,
  fullTitle,
  description,
  path,
  alternates = {},
  ogImage = SITE.ogImage,
  ogType = 'website',
  noindex = false,
  schema = [],
} = Astro.props

const pageTitle = fullTitle ?? `${title} · ${SITE.name}`
const canonical = absoluteUrl(path)
const hreflangs = Object.entries(alternates) as [Lang, string][]
const otherLangs = hreflangs.filter(([l]) => l !== lang)
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organization(), website(lang), author(), ...schema],
}
const t = ui[lang]
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {hreflangs.map(([l, p]) => <link rel="alternate" hreflang={l} href={absoluteUrl(p)} />)}
    {
      alternates[DEFAULT_LANG] && hreflangs.length > 1 && (
        <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternates[DEFAULT_LANG])} />
      )
    }
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — ${t.blog}`} href={`${lang === 'es' ? '/es' : ''}/blog/rss.xml`} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteUrl(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={LOCALES[lang]} />
    {otherLangs.map(([l]) => <meta property="og:locale:alternate" content={LOCALES[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteUrl(ogImage)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="dark" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <Header lang={lang} alternates={alternates} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <StarLink label={t.starGithub} floating />
    <Analytics />
    <script>
      // The control stays in the corner. On short screens it would sit on a button or the
      // video's own controls, so lift it just clear of those and leave it otherwise.
      const fab = document.querySelector<HTMLElement>('.star-link--fab')
      const narrow = matchMedia('(max-width: 819px)')
      if (fab) {
        const gap = 10
        const controls = 48
        let frame = 0
        const place = () => {
          fab.style.removeProperty('bottom')
          if (!narrow.matches) return
          const box = fab.getBoundingClientRect()
          if (box.width === 0) return
          let shift = 0
          for (let pass = 0; pass < 4; pass++) {
            const top = box.top - shift
            const bottom = box.bottom - shift
            let added = 0
            for (const el of document.querySelectorAll<HTMLElement>('a.button, video')) {
              const r = el.getBoundingClientRect()
              if (r.width < 2 || r.height < 2) continue
              if (box.right <= r.left + 1 || box.left >= r.right - 1) continue
              const zoneTop = el instanceof HTMLVideoElement ? Math.max(r.top, r.bottom - controls) : r.top
              if (bottom > zoneTop && top < r.bottom) added = Math.max(added, bottom - zoneTop + gap)
            }
            if (added === 0) break
            shift += added
          }
          if (shift > 0) fab.style.bottom = `calc(${16 + Math.ceil(shift)}px + env(safe-area-inset-bottom, 0px))`
        }
        const schedule = () => {
          cancelAnimationFrame(frame)
          frame = requestAnimationFrame(place)
        }
        schedule()
        addEventListener('scroll', schedule, { passive: true })
        addEventListener('resize', schedule)
        narrow.addEventListener('change', schedule)
      }
    </script>
    {import.meta.env.PROD && (
      <script is:inline>
        if ('serviceWorker' in navigator) {
          addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}))
        }
      </script>
    )}
  </body>
</html>
