---
import type { GetStaticPaths } from 'astro'
import { getAnswers, type Platform } from '../../../site/content'
import AnswerView from '../../../site/views/AnswerView.astro'

export const getStaticPaths = (async () =>
  (await getAnswers('platforms', 'es')).map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }))) satisfies GetStaticPaths

const { entry } = Astro.props as { entry: Platform }
---

<AnswerView entry={entry} />
