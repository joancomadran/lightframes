---
import type { GetStaticPaths } from 'astro'
import { getPosts, type Post } from '../../site/content'
import PostView from '../../site/views/PostView.astro'

export const getStaticPaths = (async () =>
  (await getPosts('en')).map((post) => ({ params: { slug: post.data.slug }, props: { post } }))) satisfies GetStaticPaths

const { post } = Astro.props as { post: Post }
---

<PostView post={post} />
